# ---- runtime -------------------------------------------------------------
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# URL prefix the app is served under (must match client VITE_BASE at build time)
PUBLIC_BASE=/ilcc

# ---- storage -------------------------------------------------------------
DATA_DIR=/data
DB_PATH=/data/ilcc.db
DOWNLOADS_DIR=/data/downloads

# ---- auth (identity arrives from Traefik forward-auth as X-Hydra-* headers) --
# Only trust X-Hydra-* if the request came from one of these CIDRs...
TRUSTED_PROXY_CIDR=10.42.0.0/16,127.0.0.1/32
# ...AND carries this shared secret (set by the ilcc-proxy-secret Traefik middleware)
HYDRA_PROXY_SECRET=change-me
# Comma-separated emails seeded as admins at boot. Faculty (X-Hydra-Roles contains
# "faculty") are auto-promoted to admin on first request.
SEED_ADMINS=gopeen1@newpaltz.edu

# ---- limits --------------------------------------------------------------
MAX_CODE_BYTES=65536
WS_MAX_PAYLOAD=131072
SESSION_IDLE_MS=300000
MAX_SESSIONS_PER_IP=4
GRADER_TIMEOUT_MS=5000
MAX_ZIP_MB=50
