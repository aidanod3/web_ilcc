; String I/O — read a name and print a greeting
startup:    bl main
            halt

main:       push lr
            push fp
            mov fp, sp

            lea r0, prompt
            sout r0
            lea r0, buffer
            sin r0

            lea r1, greeting
            sout r1
            lea r0, buffer
            sout r0
            lea r1, exclaim
            sout r1
            nl

            mov sp, fp
            pop fp
            pop lr
            ret

prompt:     .string "Enter your name: "
greeting:   .string "Hello, "
exclaim:    .string "!"
buffer:     .zero 20
