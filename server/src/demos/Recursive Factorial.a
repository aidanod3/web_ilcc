; Recursive Factorial — compute n! using recursion
startup:    bl main
            halt

; fact(r0) -> r0
fact:       push lr
            push fp
            mov fp, sp
            cmp r0, 1
            brn base
            brz base
            push r0
            sub r0, r0, 1
            bl fact
            pop r1
            mul r0, r0, r1
            br factDone
base:       mov r0, 1
factDone:   mov sp, fp
            pop fp
            pop lr
            ret

main:       push lr
            push fp
            mov fp, sp
            lea r0, prompt
            sout r0
            din r0
            bl fact
            lea r1, result
            sout r1
            dout r0
            nl
            mov sp, fp
            pop fp
            pop lr
            ret

prompt:     .string "Enter n: "
result:     .string "n! = "
